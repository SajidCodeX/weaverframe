# ─── WeaverFrame — Production Environment Variables Template ─────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to git.

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
# Neon serverless PostgreSQL connection string (with ?sslmode=require)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/weaverframe?sslmode=require

# ─── Security & Encryption ───────────────────────────────────────────────────
# AES-256-GCM Encryption Key: Used to encrypt mailbox & OAuth credentials in DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
DB_ENCRYPTION_KEY=

# JWT Secret: Used for signing auth session cookies (jwt_admin, jwt_builder).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── Google Workspace OAuth 2.0 (Mailbox Integration) ─────────────────────────
# Created in Google Cloud Console -> APIs & Services -> Credentials
# Redirect URIs:
#   - http://localhost:8080/api/auth/google/callback
#   - https://weaverframe.vercel.app/api/auth/google/callback
#   - https://weaverframe.in/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Application Base URL ────────────────────────────────────────────────────
# e.g., http://localhost:8080 on local or https://weaverframe.vercel.app on production
APP_BASE_URL=http://localhost:8080

# ─── AI Concierge Engines (Dual Fallback) ──────────────────────────────────────
# Primary Engine: Google Gemini Flash
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Fallback Engine: Groq Cloud (Llama 3.3 70B)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# ─── Notion Integration (Management Hub) ─────────────────────────────────────
# Notion Internal Integration Token (for WeaverFrame AI agent sync)
NOTION_TOKEN=

# ─── Transactional Email (Resend) ─────────────────────────────────────────────
# Used for direct transactional notifications and fallback outbound email
RESEND_API_KEY=

# ─── RentCast Building Permits API ───────────────────────────────────────────
# Daily building permits ingestion (Austin, TX luxury residential market)
RENCAST_API_KEY=
RENCAST_TARGET_MARKET=Austin, TX

# ─── Legacy Mailbox Fallback (Optional) ────────────────────────────────────────
# Fallback when Google OAuth is not linked (IMAP/SMTP with App Password)
# SMTP_USER=
# SMTP_PASS=
# IMAP_USER=
# IMAP_PASS=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
