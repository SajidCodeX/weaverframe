generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ─── TENANT (BUILDER) ────────────────────────────────────────────────────────
model Builder {
  id          String   @id @default(uuid())
  companyName String                           // "Horizon Homes LLC"
  contactName String                           // "Mike Patterson"
  email       String   @unique
  phone       String?
  plan        String   @default("professional") // "trial" | "professional" | "enterprise"
  isActive    Boolean  @default(true)
  adSpendBalance Float   @default(0.0)
  paymentMethod  String? @default("None")
  settings       String?  // Storing settings as stringified JSON since sqlite doesn't support Json type in Prisma
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?
  targetZipCodes String[] @default([]) // Strict 1-to-1 lead allocation rules

  users           User[]
  leads           Lead[]
  appointments    Appointment[]
  messages        Message[]
  activities      Activity[]
  reviewRequests  ReviewRequest[]
  reviewPlatforms ReviewPlatform[]
  integrations    Integration[]
  publicReviews   PublicReview[]
}

// ─── USERS (ADMIN & BUILDER STAFF) ───────────────────────────────────────────
model User {
  id                String    @id @default(uuid())
  builderId         String?                        // null = Super Admin
  email             String    @unique
  passwordHash      String                         // bcrypt hash — NEVER plaintext
  role              String    @default("builder")  // "admin" | "builder"
  displayName       String
  forcePasswordReset Boolean  @default(false)
  lastLoginAt       DateTime?
  isActive          Boolean   @default(true)
  
  // Team Permissions
  builderRole       String    @default("owner")    // "owner" | "member"
  permissions       String[]  @default([])         // e.g. ["leads:read", "settings:write"]
  
  resetToken        String?
  resetTokenExpires DateTime?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  builder       Builder?  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]    @relation("AssignedUserLeads")

  @@index([builderId])
}

// ─── LEADS ───────────────────────────────────────────────────────────────────
model Lead {
  id              String     @id @default(uuid())
  builderId       String
  builder         Builder    @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  assignedToId    String?
  assignedTo      User?      @relation("AssignedUserLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  name            String
  county          String     
  state           String     
  landPrice       Int        
  estimatedBudget Int        
  purchaseDate    DateTime   
  phone           String?    
  email           String?    
  status          String     // "New", "Emailed", "Opened", "Replied", "Appointment"
  scoreTier       String     // "Hot", "Warm", "Cold"
  source          String     @default("Organic / Local SEO")

  // ─── Hybrid SMS / Portal Fields ─────────────────────────────────────────────
  portalToken     String?   @unique  // 32-char hex magic link token
  portalVisitedAt DateTime?           // First time lead opened portal
  smsUsed         Int       @default(0)   // SMS sent so far
  smsQuota        Int       @default(20)  // Max SMS allowed (default: 20)
  lastSmsAt       DateTime?              // When last SMS was sent (for drip scheduling)
  
  // ─── AI Sales Intelligence & Lead Memory ──────────────────────────────────
  leadMemory        String?   // JSON structured memory graph: extracted preferences, timeline, family needs, objections
  dealScore         Int       @default(50)  // 0 - 100 Real-Time Buyer Readiness Score
  qualificationData String?   // JSON structured qualification checklist & next best action
  lastAiSummary     String?   // Executive 1-line AI status summary

  activities      Activity[]
  reviewRequests  ReviewRequest[]
  appointments    Appointment[]
  messages        Message[]
  
  createdAt       DateTime   @default(now())

  @@index([builderId])
  @@index([createdAt])
  @@index([builderId, createdAt])
  @@index([portalToken])
  @@index([status])
  @@index([scoreTier])
  @@index([dealScore])
  @@index([status, createdAt])
  @@index([assignedToId])
  @@index([builderId, status])
}

// ─── REVIEW PLATFORMS ────────────────────────────────────────────────────────
model ReviewPlatform {
  id           String   @id @default(uuid())
  builderId    String
  builder      Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  name         String   // "Google Business", "Houzz", "GuildQuality"
  rating       Float    // e.g., 4.8
  reviewCount  Int      // e.g., 42
  profileUrl   String
  reviewsGoal  Int      // Target number of reviews
  createdAt    DateTime @default(now())

  @@index([builderId])
}

// ─── REVIEW REQUESTS ─────────────────────────────────────────────────────────
model ReviewRequest {
  id          String   @id @default(uuid())
  builderId   String
  builder     Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  leadId      String?
  clientName  String
  clientEmail String?
  clientPhone String?
  rating      Int?     // 1-5 star selection
  status      String   // "Sent", "Opened", "Completed", "Feedback"
  feedback    String?  // Internal feedback for 1-3 stars
  platform    String?  // Targeted platform for 4-5 stars
  createdAt   DateTime @default(now())
  sentAt      DateTime @default(now())
  
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([builderId])
  @@index([leadId])
  @@index([builderId, createdAt])
}

// ─── ACTIVITY TIMELINE ───────────────────────────────────────────────────────
model Activity {
  id        String   @id @default(uuid())
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  leadId    String
  action    String   
  createdAt DateTime @default(now())
  
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([builderId])
  @@index([leadId])
  @@index([createdAt])
  @@index([builderId, createdAt])
}

// ─── APPOINTMENTS ────────────────────────────────────────────────────────────
model Appointment {
  id        String   @id @default(uuid())
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  leadId    String
  type      String   // "Phone call" | "Site visit" | "Follow-up"
  dateTime  DateTime
  location  String
  status    String   // "Confirmed" | "Pending" | "Cancelled"
  notes     String?
  createdAt DateTime @default(now())
  
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([builderId])
  @@index([leadId])
  @@index([createdAt])
  @@index([builderId, createdAt])
  @@index([builderId, dateTime])
}

// ─── MESSAGES ────────────────────────────────────────────────────────────────
model Message {
  id        String   @id @default(uuid())
  builderId String
  builder   Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  leadId    String
  sender    String   // "lead" | "user" | "system"
  content   String
  channel   String   @default("portal")  // "portal" | "sms"
  isRead    Boolean  @default(false)
  isSimulated Boolean @default(false) // True if this was generated via the Simulate Lead feature
  createdAt DateTime @default(now())
  
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([builderId])
  @@index([leadId])
  @@index([builderId, leadId])
  @@index([createdAt])
}

// ─── INTEGRATIONS ────────────────────────────────────────────────────────────
model Integration {
  id           String   @id @default(uuid())
  builderId    String
  builder      Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  platformId   String   
  isConnected  Boolean  @default(false)
  configSecure String
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
  
  @@unique([builderId, platformId])
}

// ─── PUBLIC REVIEWS (EXTERNAL SITES) ─────────────────────────────────────────
model PublicReview {
  id          String   @id @default(uuid())
  builderId   String
  builder     Builder  @relation(fields: [builderId], references: [id], onDelete: Cascade)
  
  clientName  String
  platform    String   // "Google Business", "Houzz", "GuildQuality"
  rating      Int
  sentAt      DateTime @default(now())
  reviewText  String   @db.Text
  projectType String?
  location    String?
  status      String   @default("Unanswered") // "Unanswered" | "Answered"
  replyText   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([builderId])
  @@index([builderId, createdAt])
}

// ─── PLATFORM SETTINGS ───────────────────────────────────────────────────────
model PlatformSettings {
  id               String   @id @default("global")
  supportEmail     String   @default("support@buildersedge.com")
  defaultTrialDays Int      @default(14)
  maintenanceMode  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

// ─── SYSTEM SYNC (BACKGROUND JOBS) ───────────────────────────────────────────
model SystemSync {
  id               String   @id @default("rencast_leads")
  lastSyncAt       DateTime @default(now())
  recordsFetched   Int      @default(0)
  status           String   @default("Success") // "Success" | "Failed"
  errorMessage     String?
}

// ─── DEMO REQUESTS (PLATFORM / SUPER ADMIN ONLY - ZERO BUILDER COUPLING) ─────
model DemoRequest {
  id              String    @id @default(uuid())
  name            String
  email           String
  phone           String
  company         String    // Architectural firm / builder company requesting demo
  buildVolume     String    // e.g. "$1M - $3M", "5+ Custom Homes / Year"
  status          String    @default("new") // "new" | "contacted" | "scheduled" | "completed" | "archived"
  notes           String?   @db.Text
  portalToken     String?   @unique
  portalVisitedAt DateTime?
  metadata        String?   @db.Text // JSON structured extra data
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

// ─── PERSISTENT AI DELAY QUEUE (DURABLE WORKER JOBS) ──────────────────────────
model ScheduledAiReply {
  id             String    @id @default(uuid())
  builderId      String
  leadId         String
  conversationId String?
  scheduledFor   DateTime
  status         String    @default("pending") // "pending" | "processing" | "sent" | "cancelled" | "failed"
  payload        String    @db.Text             // JSON string: { userMessage, senderEmail, attempts }
  attempts       Int       @default(0)
  lastError      String?   @db.Text
  sentAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, scheduledFor])
  @@index([leadId, status])
  @@index([builderId])
}

